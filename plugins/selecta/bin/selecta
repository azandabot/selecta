#!/bin/sh
# selecta command-line entry point.
#
# A thin client. It resolves queries, hands metadata to the supervisor through
# run/source.json, and drives playback over mpv's IPC socket. The supervisor
# owns every durable write.

set -eu

SELECTA_BIN=$0
case $SELECTA_BIN in
*/*) ;;
*) SELECTA_BIN=$(command -v -- "$SELECTA_BIN") ;;
esac
while [ -L "$SELECTA_BIN" ]; do
	_link=$(readlink -- "$SELECTA_BIN")
	case $_link in
	/*) SELECTA_BIN=$_link ;;
	*) SELECTA_BIN=$(dirname -- "$SELECTA_BIN")/$_link ;;
	esac
done
SELECTA_ROOT=$(cd -- "$(dirname -- "$SELECTA_BIN")/.." && pwd -P)
export SELECTA_ROOT

# shellcheck source=lib/common.sh
. "$SELECTA_ROOT/lib/common.sh"
# shellcheck source=lib/repo.sh
. "$SELECTA_ROOT/lib/repo.sh"
# shellcheck source=lib/resolve.sh
. "$SELECTA_ROOT/lib/resolve.sh"
# shellcheck source=lib/resolve-net.sh
. "$SELECTA_ROOT/lib/resolve-net.sh"
# shellcheck source=lib/player.sh
. "$SELECTA_ROOT/lib/player.sh"
# shellcheck source=lib/ipc.sh
. "$SELECTA_ROOT/lib/ipc.sh"
# shellcheck source=lib/nowplaying.sh
. "$SELECTA_ROOT/lib/nowplaying.sh"
# shellcheck source=lib/state.sh
. "$SELECTA_ROOT/lib/state.sh"
# shellcheck source=lib/soundtrack.sh
. "$SELECTA_ROOT/lib/soundtrack.sh"
# shellcheck source=lib/route.sh
. "$SELECTA_ROOT/lib/route.sh"
# shellcheck source=lib/statusline.sh
. "$SELECTA_ROOT/lib/statusline.sh"

# Plugins install under a versioned cache path that changes on every update,
# so the status line launcher cannot hardcode a way back to us. These two
# pointers are refreshed on every run and self-heal after an update.
_selecta_write_pointers() {
	mkdir -p "$SELECTA_HOME" 2>/dev/null || return 0
	printf '%s\n' "$SELECTA_ROOT" >"$SELECTA_HOME/root" 2>/dev/null || true
	printf '%s/bin/%s\n' "$SELECTA_ROOT" "$(basename -- "$SELECTA_BIN")" \
		>"$SELECTA_HOME/bin-path" 2>/dev/null || true
	selecta_sl_refresh_copy 2>/dev/null || true
}

usage() {
	cat <<'EOF'
selecta - background music for your coding sessions

  selecta                       what is playing, and this repo's crate
  selecta play [mood]           resolve and play; no argument resumes this repo
  selecta resume                this repo's top-ranked source
  selecta pause | go            pause, unpause
  selecta next                  next source in this repo's rotation
  selecta stop                  stop playback, keep state
  selecta vol <0-100|+10|-10|mute>

  selecta crate                 what this repo sounds like
  selecta crate --history [n]   tracks, grouped by the commit they scored
  selecta crate --path          where this repo's crate file lives
  selecta stations [query]      browse the catalog without playing

  selecta statusline on|off|status
  selecta doctor                dependency and health check
  selecta config [key [value]]
  selecta uninstall [--purge]

Music comes from SomaFM, radio-browser and the Internet Archive netlabels
collection. Nothing is downloaded and no account is required.
EOF
}

canonicalize() {
	case $1 in
	quiet) echo stop ;;
	skip) echo next ;;
	unpause | play-pause) echo go ;;
	here | soundtrack) echo crate ;;
	volume) echo vol ;;
	status) echo '' ;;
	*) echo "$1" ;;
	esac
}

unknown_subcommand() {
	printf 'selecta: unknown command "%s". Did you mean: selecta play %s\n' "$1" "$1" >&2
	printf 'Run "selecta --help" for the full list.\n' >&2
	exit "$EX_USAGE"
}

# --- helpers ----------------------------------------------------------------

human_secs() {
	_hs=${1:-0}
	case $_hs in '' | *[!0-9]*) _hs=0 ;; esac
	if [ "$_hs" -lt 60 ]; then
		printf '%ds' "$_hs"
	elif [ "$_hs" -lt 3600 ]; then
		printf '%dm' "$((_hs / 60))"
	else
		printf '%dh %dm' "$((_hs / 3600))" "$(((_hs % 3600) / 60))"
	fi
}

# Starts the supervisor when no player is up. Preferred path is the plugin
# monitor, which the host starts on skill invoke and reaps at session end. This
# detached fallback exists for direct CLI use and for hosts where monitors are
# unavailable; the supervisor's watchdog is what stops it becoming an orphan.
ensure_player() {
	selecta_ipc_up && return 0
	selecta_ensure_dirs || selecta_die "$EX_UNWRITABLE" "cannot write to $SELECTA_HOME"
	# A crashed supervisor leaves its socket, pidfile and lock behind. Clear
	# them first or the new one loses the lock to a process that no longer
	# exists and exits silently.
	selecta_ipc_reap
	selecta_lock_reap_stale
	if [ "$(selecta_engine)" = none ]; then
		printf 'selecta: no player installed.\n\n  %s\n\nThen run: selecta play\n' \
			"$(selecta_install_hint 'mpv jq')" >&2
		exit "$EX_MISSING_DEP"
	fi
	: >"$SELECTA_HEARTBEAT"
	: >"$SELECTA_RUN/want-mpv"
	if selecta_have setsid; then
		setsid "$SELECTA_ROOT/libexec/selecta-supervisor" --detached </dev/null >/dev/null 2>&1 &
	else
		nohup "$SELECTA_ROOT/libexec/selecta-supervisor" --detached </dev/null >/dev/null 2>&1 &
	fi
	selecta_mpv_wait 200 || selecta_die "$EX_MISSING_DEP" "player did not start. Run: selecta doctor"
}

# Resolves a source id to a live URL. The resolver, never the caller, decides
# what URL a name maps to.
stream_for() {
	case $1 in
	somafm:*) selecta_somafm_stream "${1#somafm:}" ;;
	rb:*) selecta_rb_stream "${1#rb:}" ;;
	*) return "$EX_NOTFOUND" ;;
	esac
}

# Hands the supervisor what mpv cannot know, then starts playback. source.json
# is written first so the supervisor has it before the file-loaded event.
start_source() {
	_ss_card=$1
	selecta_np_pause_others
	_ss_urls=$(stream_for "$(printf '%s' "$_ss_card" | jq -r .id)") || {
		printf 'selecta: could not reach %s\n' \
			"$(printf '%s' "$_ss_card" | jq -r .title)" >&2
		return "$EX_NETWORK"
	}
	[ -n "$_ss_urls" ] || {
		printf 'selecta: no playable stream for %s\n' \
			"$(printf '%s' "$_ss_card" | jq -r .title)" >&2
		return "$EX_NETWORK"
	}

	_ss_first=$(printf '%s\n' "$_ss_urls" | head -1)
	_ss_mirrors=$(printf '%s\n' "$_ss_urls" | tail -n +2 | jq -R -s 'split("\n")|map(select(length>0))')

	printf '%s' "$_ss_card" | jq \
		--arg uri "$_ss_first" --argjson mirrors "$_ss_mirrors" \
		--argjson repo "$(selecta_json_or "$(repo_json)" '{}')" \
		'. + {uri: $uri, mirrors: $mirrors, repo: $repo}' |
		selecta_atomic_write "$SELECTA_RUN/source.json"

	ensure_player
	# Clear state before issuing the command. A leftover "playing" from a
	# previous session satisfies the wait below instantly, and the banner then
	# reports the old track as though this one had started.
	selecta_state_write stopped 2>/dev/null || true
	_ss_reply=$(selecta_ipc_command "[\"loadfile\",$(printf '%s' "$_ss_first" | jq -R .)]")
	# Never announce playback we have not seen. The banner used to print
	# unconditionally, so a dead player still looked like success.
	printf '%s' "$_ss_reply" | grep -q '"error":"success"' || {
		printf 'selecta: the player did not accept that stream. Run: selecta doctor\n' >&2
		return "$EX_NETWORK"
	}

	if wait_until_playing 40; then
		printf '%s\n' "$(printf '%s' "$_ss_card" | jq -r '"▶ " + .title')"
		return 0
	fi

	# SomaFM rotates its endpoints, which is what the mirrors in the playlist
	# are for. They were being stored and never used.
	for _ss_alt in $(printf '%s\n' "$_ss_urls" | tail -n +2); do
		selecta_log info "mirror retry: $_ss_alt"
		selecta_state_write stopped 2>/dev/null || true
		selecta_ipc_command "[\"loadfile\",$(printf '%s' "$_ss_alt" | jq -R .)]" >/dev/null
		if wait_until_playing 30; then
			printf '%s\n' "$(printf '%s' "$_ss_card" | jq -r '"▶ " + .title')"
			return 0
		fi
	done

	printf 'selecta: %s was accepted but never started playing.\n' \
		"$(printf '%s' "$_ss_card" | jq -r .title)" >&2
	return "$EX_NETWORK"
}

# A YouTube entry in the crate can only be replayed by the plugin that put it
# there. Without selecta-youtube installed the entry is skipped and the
# rotation moves on, rather than the whole command failing.
yt_play_card() {
	_yp_bin=$(selecta_yt_bin) || {
		printf 'selecta: "%s" came from YouTube, which is a separate plugin.\n\n' \
			"$(printf '%s' "$1" | jq -r '.title // "that track"')" >&2
		selecta_yt_install_hint >&2
		return "$EX_MISSING_DEP"
	}
	printf '%s' "$1" | "$_yp_bin" __replay
}

# Routes a crate entry to the backend that can actually play it. Without this,
# a YouTube entry went down the radio path, stream_for had no branch for it,
# and resume reported "could not reach that stream" forever.
play_source() {
	case $(printf '%s' "$1" | jq -r .id) in
	youtube:*) yt_play_card "$1" ;;
	somafm:* | rb:*) start_source "$1" ;;
	*)
		printf 'selecta: do not know how to play %s\n' \
			"$(printf '%s' "$1" | jq -r .id)" >&2
		return "$EX_NOTFOUND"
		;;
	esac
}

# Walks the ranked crate until something plays. A dead top pick used to end the
# command rather than moving on to the next source.
play_ranked() {
	_pr_doc=$1
	_pr_skip=${2:-}
	_pr_list=$(selecta_st_rank "$_pr_doc")
	_pr_n=$(printf '%s' "$_pr_list" | jq 'length')
	[ "$_pr_n" -gt 0 ] || {
		printf 'selecta: this crate has no playable sources\n' >&2
		return "$EX_NOTFOUND"
	}
	_pr_i=0
	while [ "$_pr_i" -lt "$_pr_n" ]; do
		_pr_card=$(printf '%s' "$_pr_list" | jq -c ".[$_pr_i]")
		_pr_i=$((_pr_i + 1))
		_pr_id=$(printf '%s' "$_pr_card" | jq -r .id)
		[ "$_pr_id" = "$_pr_skip" ] && continue
		if play_source "$(printf '%s' "$_pr_card" | jq -c '{id,kind,provider,title,resolver}')"; then
			selecta_st_clear_failure "$(repo_json | jq -r .key)" "$_pr_id" || true
			return 0
		fi
		selecta_st_mark_failure "$(repo_json | jq -r .key)" "$_pr_id" || true
		[ "$_pr_i" -lt "$_pr_n" ] && printf '  trying the next source in the crate…\n' >&2
	done
	printf 'selecta: nothing in this crate would play. Try: selecta play <mood>\n' >&2
	return "$EX_NETWORK"
}

# Blocks until the state file reports playback, bounded. This is the only
# honest basis for printing a success banner.

# --- commands ---------------------------------------------------------------

clock() {
	_ck=${1:-0}
	case $_ck in '' | null | *[!0-9]*) _ck=0 ;; esac
	printf '%d:%02d' "$((_ck / 60))" "$((_ck % 60))"
}

# Whether something is genuinely playing is probed, never read from the state
# file, which can outlive the process that wrote it.
live_backend() {
	if selecta_window_up; then
		printf 'youtube'
	elif selecta_ipc_up; then
		printf 'radio'
	else
		printf 'none'
	fi
}

cmd_status() {
	_cs_state=$(selecta_state_read)
	_cs_status=$(printf '%s' "$_cs_state" | jq -r '.status // "stopped"')
	_cs_live=$(live_backend)

	if [ "$_cs_live" = none ]; then
		printf '  ✕ nothing playing\n'
		[ "$_cs_status" != stopped ] &&
			printf '    (state said "%s" but no player is running, so it was stale)\n' "$_cs_status"
	else
		case $_cs_status in
		playing) _cs_glyph='▶' ;;
		paused) _cs_glyph='❚❚' ;;
		buffering) _cs_glyph='…' ;;
		error) _cs_glyph='✕' ;;
		*) _cs_glyph='·' ;;
		esac
		printf '  %s %s\n' "$_cs_glyph" \
			"$(printf '%s' "$_cs_state" | jq -r '
				if (.now.title // "") != "" then
					((if (.now.artist // "") != "" then .now.artist + " — " else "" end) + .now.title)
				else (.source.title // "?") end')"
		printf '    %s' "$(printf '%s' "$_cs_state" | jq -r '
			"\(.status) · \(.source.provider // "?")" +
			(if (.source.title // "") != "" then " · " + .source.title else "" end)')"
		_cs_pos=$(printf '%s' "$_cs_state" | jq -r '.position // empty')
		_cs_dur=$(printf '%s' "$_cs_state" | jq -r '.duration // empty')
		if [ -n "$_cs_pos" ] && [ "${_cs_dur:-0}" -gt 0 ] 2>/dev/null; then
			printf ' · %s / %s' "$(clock "$_cs_pos")" "$(clock "$_cs_dur")"
		fi
		printf '\n'
		_cs_url=$(printf '%s' "$_cs_state" | jq -r '.source.attribution_url // empty')
		[ -n "$_cs_url" ] && printf '    %s\n' "$_cs_url"
	fi

	# Quota is the number people actually need, and the caching rule is the
	# part that is never obvious: replaying costs nothing.

	if _cs_doc=$(selecta_st_load "$(repo_json | jq -r .key)" 2>/dev/null); then
		printf '  crate    %s · %s · %s sources · %s tracks\n' \
			"$(printf '%s' "$_cs_doc" | jq -r .display_name)" \
			"$(human_secs "$(printf '%s' "$_cs_doc" | jq -r '.totals.seconds')")" \
			"$(printf '%s' "$_cs_doc" | jq -r '.sources|length')" \
			"$(printf '%s' "$_cs_doc" | jq -r '.totals.tracks')"
		printf '\n  selecta resume  →  %s\n' \
			"$(selecta_st_rank "$_cs_doc" | jq -r '.[0].title // "nothing yet"')"
	else
		printf '  crate    empty. Start one: selecta play <mood>\n\n'
	fi
	printf '  ★ %s\n' "$SELECTA_REPO_URL"
}

cmd_play() {
	_cp_force=''
	_cp_args=''
	for _cp_a in "$@"; do
		case $_cp_a in
		--yt | --youtube) _cp_force=yt ;;
		--radio) _cp_force=radio ;;
		*) _cp_args="$_cp_args${_cp_args:+ }$_cp_a" ;;
		esac
	done
	# shellcheck disable=SC2086
	set -- $_cp_args
	_cp_q=$*
	if [ -z "$_cp_q" ]; then
		cmd_resume
		return $?
	fi
	selecta_ensure_dirs || selecta_die "$EX_UNWRITABLE" "cannot write to $SELECTA_HOME"

	_cp_res=$(selecta_resolve "$_cp_q")
	_cp_status=$(printf '%s' "$_cp_res" | jq -r .status)

	if [ "$_cp_force" = yt ] || { [ "$_cp_force" != radio ] && wants_youtube "$_cp_q" "$_cp_res"; }; then
		if _cp_yb=$(selecta_yt_bin); then
			exec "$_cp_yb" play "$_cp_q"
		fi
		printf 'selecta: "%s" looks like one specific track. Radio cannot pick those.\n\n' \
			"$_cp_q" >&2
		selecta_yt_install_hint >&2
		[ "$_cp_force" = yt ] && exit "$EX_MISSING_DEP"
		printf '\nPlaying radio instead.\n\n' >&2
	fi

	if [ "$_cp_status" != ok ]; then
		_cp_tags=$(printf '%s' "$_cp_res" | jq -r '.hint_tags|join(",")')
		if [ -n "$_cp_tags" ]; then
			_cp_res=$(selecta_resolve_net "$_cp_q" "$_cp_tags")
			_cp_status=$(printf '%s' "$_cp_res" | jq -r .status)
		fi
	fi

	if [ "$_cp_status" != ok ]; then
		printf 'selecta: nothing solid matched "%s".\n' "$_cp_q" >&2
		_cp_n=$(printf '%s' "$_cp_res" | jq -r '.candidates|length')
		if [ "$_cp_n" -gt 0 ]; then
			printf 'Closest:\n' >&2
			printf '%s' "$_cp_res" | jq -r '.candidates[0:3][] | "  \(.id)  \(.title)"' >&2
		fi
		printf 'Browse instead: selecta stations\n' >&2
		exit "$EX_NOTFOUND"
	fi

	play_source "$(printf '%s' "$_cp_res" | jq -c '.candidates[0]')" ||
		selecta_die "$EX_NETWORK" "could not start that source"
}

cmd_resume() {
	_cr_key=$(repo_json | jq -r .key)
	_cr_doc=$(selecta_st_load "$_cr_key" 2>/dev/null) || {
		_cr_default=$(selecta_cfg_get '.default_station' '"somafm:groovesalad"' | tr -d '"')
		printf 'New crate for %s.\n' "$(repo_json | jq -r .display_name)"
		printf 'Starting with your default. Steer it: selecta play <mood>\n'
		_cr_card=$(selecta_resolve "${_cr_default#somafm:}" | jq -c '.candidates[0]')
		[ "$_cr_card" != null ] || selecta_die "$EX_NOTFOUND" "default station is not resolvable"
		play_source "$_cr_card" || selecta_die "$EX_NETWORK" "could not start the default station"
		return 0
	}
	play_ranked "$_cr_doc"
}

cmd_next() {
	_cn_doc=$(selecta_st_load "$(repo_json | jq -r .key)" 2>/dev/null) ||
		selecta_die "$EX_NOTFOUND" "no crate for this repo yet"
	_cn_cur=$(selecta_state_read | jq -r '.source.id // ""')
	_cn_ranked=$(selecta_st_rank "$_cn_doc")
	_cn_count=$(printf '%s' "$_cn_ranked" | jq 'length')
	[ "$_cn_count" -gt 0 ] || selecta_die "$EX_NOTFOUND" "nothing to rotate to"
	# A live radio stream cannot skip a track. Saying so is better than
	# pretending: the station changes, and the user should know that.
	printf 'Moving to the next source in this crate.\n'
	_cn_rot=$(printf '%s' "$_cn_ranked" | jq -c --arg cur "$_cn_cur" '
		(map(.id) | index($cur)) as $i
		| if $i == null then . else (.[($i + 1):] + .[0:($i + 1)]) end')
	play_ranked "$(jq -nc --argjson s "$_cn_rot" '{sources: $s}')" "$_cn_cur"
}

# Control has to reach whichever backend is actually playing. These used to
# talk only to mpv, so with a YouTube track playing `stop` and `pause` reported
# "nothing is playing" while the music carried on in the window.
cmd_pause() {
	case $(live_backend) in
	youtube)
		selecta_yt_queue '{"action":"pause"}'
		printf 'Paused.\n'
		;;
	radio)
		selecta_ipc_command '["set_property","pause",true]' >/dev/null
		printf 'Paused.\n'
		;;
	*) selecta_die "$EX_NOTFOUND" "nothing is playing" ;;
	esac
}

cmd_go() {
	case $(live_backend) in
	youtube)
		selecta_yt_queue '{"action":"play"}'
		printf 'Playing.\n'
		;;
	radio)
		selecta_ipc_command '["set_property","pause",false]' >/dev/null
		printf 'Playing.\n'
		;;
	*) selecta_die "$EX_NOTFOUND" "nothing is playing" ;;
	esac
}

cmd_stop() {
	_cst_hit=0
	# Both are stopped, not just the live one: a stale backend left running
	# from an earlier command is exactly what makes "stop" look broken.
	if selecta_window_up; then
		selecta_yt_queue '{"action":"stop"}'
		_cst_hit=1
	fi
	# Closed, not just silenced. A muted window left on screen is the thing
	# that piles up, and "stopped" with a player still open is not stopped.
	selecta_yt_window_close
	if selecta_ipc_up; then
		selecta_ipc_command '["stop"]' >/dev/null
		_cst_hit=1
	fi
	rm -f "$SELECTA_RUN/want-mpv" 2>/dev/null
	selecta_state_write stopped 2>/dev/null || true
	if [ "$_cst_hit" -eq 1 ]; then
		printf 'Stopped.\n'
	else
		printf 'Nothing playing.\n'
	fi
}

cmd_vol() {
	_cv_back=$(live_backend)
	[ "$_cv_back" != none ] || selecta_die "$EX_NOTFOUND" "nothing is playing"
	if [ "$_cv_back" = youtube ]; then
		case ${1:-} in
		'') selecta_die "$EX_USAGE" "volume needs a value in the player window" ;;
		mute) selecta_yt_queue '{"action":"mute"}' ;;
		unmute) selecta_yt_queue '{"action":"unmute"}' ;;
		*[!0-9]*) selecta_die "$EX_USAGE" "youtube volume takes 0-100, mute or unmute" ;;
		*) selecta_yt_queue "$(jq -nc --argjson v "$1" '{action:"volume",value:$v}')" ;;
		esac
		case ${1:-} in
		mute | unmute) printf '%sd.\n' "$1" ;;
		*) printf 'Volume %s\n' "$1" ;;
		esac
		return 0
	fi
	_cv=${1:-}
	[ -n "$_cv" ] || {
		printf '%s\n' "$(selecta_ipc_get volume | cut -d. -f1)"
		return 0
	}
	case $_cv in
	mute)
		selecta_ipc_command '["set_property","mute",true]' >/dev/null
		printf 'Muted.\n'
		return 0
		;;
	unmute)
		selecta_ipc_command '["set_property","mute",false]' >/dev/null
		printf 'Unmuted.\n'
		return 0
		;;
	+*) _cv=$(($(selecta_ipc_get volume | cut -d. -f1) + ${_cv#+})) ;;
	-*) _cv=$(($(selecta_ipc_get volume | cut -d. -f1) - ${_cv#-})) ;;
	*[!0-9]*) selecta_die "$EX_USAGE" "volume takes 0-100, +N, -N, mute or unmute" ;;
	esac
	[ "$_cv" -lt 0 ] && _cv=0
	[ "$_cv" -gt 100 ] && _cv=100
	selecta_ipc_command "[\"set_property\",\"volume\",$_cv]" >/dev/null
	printf 'Volume %s\n' "$_cv"
}

cmd_crate() {
	# --history is the commit-grouped view. It was a separate subcommand; the
	# feature is the differentiator but it does not need its own router entry.
	case ${1:-} in
	--history) shift; cmd_history "$@"; return $? ;;
	--path)
		_cp_key=$(repo_json | jq -r .key)
		selecta_st_load "$_cp_key" >/dev/null 2>&1 || return "$EX_NOTFOUND"
		selecta_st_file_for "$_cp_key"
		printf '\n'
		return 0
		;;
	esac
	_cc_repo=$(repo_json)
	_cc_doc=$(selecta_st_load "$(printf '%s' "$_cc_repo" | jq -r .key)" 2>/dev/null) || {
		printf 'No crate yet for %s.\nStart one: selecta play <mood>\n' \
			"$(printf '%s' "$_cc_repo" | jq -r .display_name)"
		return 0
	}
	_cc_total=$(printf '%s' "$_cc_doc" | jq -r '.totals.seconds')
	_cc_tracks=$(printf '%s' "$_cc_doc" | jq -r '.totals.tracks')
	printf '\n  %s   %s · %s track%s · since %s\n\n' \
		"$(printf '%s' "$_cc_doc" | jq -r .display_name)" \
		"$(human_secs "$_cc_total")" \
		"$_cc_tracks" \
		"$([ "$_cc_tracks" = 1 ] || printf s)" \
		"$(printf '%s' "$_cc_doc" | jq -r '.created_at|split("T")[0]')"

	selecta_st_rank_by_time "$_cc_doc" | jq -r --argjson total "$([ "$_cc_total" -gt 0 ] && echo "$_cc_total" || echo 1)" '
		.[0:6][] |
		((.seconds // 0) * 10 / $total | floor) as $bars |
		"  \(.title[0:20] + (" " * (20 - (.title[0:20]|length))))" +
		"\(if .pinned then "📌" else "  " end) " +
		"\("█" * (if $bars > 10 then 10 else $bars end))\("░" * (10 - (if $bars > 10 then 10 else $bars end)))" +
		"  " + ((.seconds // 0) as $s |
			if $s < 60 then "\($s)s"
			elif $s < 3600 then "\($s / 60 | floor)m"
			else "\($s / 3600 | floor)h \(($s % 3600) / 60 | floor)m" end)'

	_cc_top=$(printf '%s' "$_cc_doc" | jq -r '
		[.tracks[] | select(.title != "") | "\(.artist) — \(.title)"]
		| group_by(.) | max_by(length) | if . == null then "" else "\(.[0])  (\(length)×)" end' 2>/dev/null)
	[ -n "$_cc_top" ] && printf '\n  On repeat        %s\n' "$_cc_top"
	_cc_first=$(printf '%s' "$_cc_doc" | jq -r '
		.tracks[0] // empty | select(.title != "")
		| "\(.artist) — \(.title), on \(.t|split("T")[0])" +
		  (if .commit != "" then " while you wrote \(.commit)" else "" end)')
	[ -n "$_cc_first" ] && printf '  First track      %s\n' "$_cc_first"
	printf '\n  selecta resume  →  %s\n\n' \
		"$(selecta_st_rank "$_cc_doc" | jq -r '.[0].title // "nothing yet"')"
}

cmd_history() {
	_ch_n=${1:-30}
	case $_ch_n in *[!0-9]*) _ch_n=30 ;; esac
	_ch_doc=$(selecta_st_load "$(repo_json | jq -r .key)" 2>/dev/null) || {
		printf 'No crate yet for this repo.\n'
		return 0
	}
	printf '%s' "$_ch_doc" | jq -r --argjson n "$_ch_n" '
		[.tracks[] | select(.title != "")] | .[-$n:] | reverse
		| group_by(.commit)
		| sort_by(.[0].t) | reverse
		| .[] |
		"  \(if .[0].commit == "" then "(no commit)" else .[0].commit end)   \(.[0].t|split("T")[0]) \(.[0].t|split("T")[1][0:5])\n" +
		"           \(length) tracks\n" +
		(map("             \(.artist) — \(.title)") | join("\n"))'
}

cmd_stations() {
	_cst_q=$*
	if [ -z "$_cst_q" ]; then
		jq -r '.channels[] | "  \(.id[0:18] + (" " * (18 - (.id[0:18]|length))))\(.title)  — \(.genre)"' \
			"$(selecta_catalog)"
		return 0
	fi
	_cst_res=$(selecta_resolve "$_cst_q")
	_cst_n=$(printf '%s' "$_cst_res" | jq -r '.candidates|length')
	if [ "$_cst_n" -eq 0 ]; then
		_cst_tags=$(printf '%s' "$_cst_res" | jq -r '.hint_tags|join(",")')
		[ -n "$_cst_tags" ] && _cst_res=$(selecta_resolve_net "$_cst_q" "$_cst_tags")
	fi
	printf '%s' "$_cst_res" | jq -r '.candidates[] | "  \(.score)  \(.id)  \(.title)"'
	printf '\nPlay one: selecta play <id>\n'
}

cmd_statusline() {
	case ${1:-status} in
	status)
		printf 'settings: %s\nstate: %s\ninstalled: %s\n' \
			"$(selecta_sl_settings_path)" "$(selecta_sl_detect)" \
			"$(selecta_cfg_get '.statusline.installed' false)"
		;;
	on)
		_sl_yes=0
		[ "${2:-}" = --user-confirmed ] && _sl_yes=1
		_sl_state=$(selecta_sl_detect)
		case $_sl_state in
		jsonc | unparseable | readonly | nojq)
			printf 'selecta: %s is %s, so it will not be edited automatically.\n\n' \
				"$(selecta_sl_settings_path)" "$_sl_state" >&2
			printf 'Add this yourself:\n\n%s\n' "$(selecta_sl_preview)" >&2
			exit "$EX_UNWRITABLE"
			;;
		esac
		printf 'selecta would add this to %s:\n\n%s\n' \
			"$(selecta_sl_settings_path)" "$(selecta_sl_preview)"
		printf '\nTwo things worth knowing first:\n'
		printf '  • Setting a status line hides most of the built-in footer key hints.\n'
		printf '  • This edits your global settings, not this repository.\n'
		[ "$_sl_state" = foreign ] &&
			printf '  • You already have a status line. Yours stays, and runs first.\n'
		printf '\nA backup is written before any change. Undo with: selecta statusline off\n'
		if [ "$_sl_yes" -ne 1 ]; then
			selecta_confirm y 'Add it? [y/N] ' 'selecta statusline on --user-confirmed' || return $?
		fi
		_sl_mode=$(selecta_sl_install) || selecta_die "$EX_UNWRITABLE" "could not write settings"
		printf 'Installed (%s mode). Restart or open a new session to see it.\n' "$_sl_mode"
		;;
	off)
		selecta_sl_uninstall || selecta_die "$EX_UNWRITABLE" "could not write settings"
		printf 'Removed. Footer key hints come back on the next session.\n'
		;;
	*) selecta_die "$EX_USAGE" "statusline takes on, off or status" ;;
	esac
}

cmd_doctor() {
	_cd_fail=0
	printf 'selecta %s\n' "$SELECTA_VERSION"
	# The running location is printed because `plugin install` copies the
	# plugin rather than referencing it. A stale snapshot is otherwise
	# invisible and looks like the code simply not working.
	printf 'running from %s\n\n' "$SELECTA_ROOT"

	for _cd_t in jq curl git; do
		if selecta_have "$_cd_t"; then
			printf '  ok       %s\n' "$_cd_t"
		else
			printf '  MISSING  %s\n' "$_cd_t"
			_cd_fail=1
		fi
	done

	_cd_engine=$(selecta_engine)
	_cd_want=''
	case $_cd_engine in
	mpv) printf '  ok       mpv (%s)\n' "$(mpv --version 2>/dev/null | head -1 | cut -d' ' -f2)" ;;
	none)
		printf '  absent   mpv, so radio cannot play. Reading Spotify, Apple\n'
		printf '           Music or an MPRIS player does not need it.\n'
		_cd_want=mpv
		;;
	esac

	selecta_have jq || _cd_want="${_cd_want:+$_cd_want }jq"
	if [ -n "$_cd_want" ]; then
		printf '\nTo install:\n\n  %s\n\n' "$(selecta_install_hint "$_cd_want")"
		printf 'selecta will not run that for you. Copy it if it looks right.\n'
	fi

	if ! selecta_have jq; then
		printf '\n  Everything below needs jq. Install it and run doctor again.\n'
		exit "$EX_MISSING_DEP"
	fi

	selecta_ensure_dirs 2>/dev/null || true
	printf '\n  home     %s (%s)\n' "$SELECTA_HOME" \
		"$([ -w "$SELECTA_HOME" ] 2>/dev/null && echo writable || echo "NOT WRITABLE")"
	# Probed, never read from state. A stale state file previously made this
	# report a running player when nothing was alive.
	if selecta_ipc_up; then
		printf '  player   responding\n'
	elif [ -S "$SELECTA_MPV_SOCK" ]; then
		printf '  player   DEAD SOCKET (cleared on next play)\n'
	else
		printf '  player   not running\n'
	fi
	_cd_t=$(selecta_ipc_transport)
	if [ "$_cd_t" = none ]; then
		printf '  ipc      MISSING. Needs one of: nc with -U, ncat, socat, python3\n'
		printf '           Radio cannot play without it; the status line still works.\n'
	else
		printf '  ipc      %s\n' "$_cd_t"
	fi
	printf '  players  %s\n' "$(selecta_np_capability)"
	printf '  window   %s\n' "$(selecta_window_up && echo "player page live" || echo "closed")"
	_cd_state=$(selecta_state_read | jq -r '.status // "stopped"')
	if [ "$_cd_state" != stopped ] && ! selecta_ipc_up && ! selecta_window_up; then
		printf '  state    STALE (says %s with nothing running)\n' "$_cd_state"
	else
		printf '  state    %s\n' "$_cd_state"
	fi
	printf '  status   %s\n' "$(selecta_sl_detect)"
	printf '  crates   %s\n' \
		"$(find "$SELECTA_SOUNDTRACKS" -name '*.json' ! -name index.json 2>/dev/null | wc -l | tr -d ' ')"
	if selecta_yt_bin >/dev/null 2>&1; then
		printf '  youtube  installed · detail: selecta-youtube doctor\n'
	else
		printf '  youtube  not installed (optional, for playing named tracks)\n'
	fi
	[ "$_cd_fail" -eq 1 ] && exit "$EX_MISSING_DEP"
	return 0
}

cmd_config() {
	[ $# -gt 0 ] || {
		[ -s "$SELECTA_CONFIG" ] && cat "$SELECTA_CONFIG" || printf '{}\n'
		return 0
	}
	_cfg_key=$1
	shift
	[ $# -gt 0 ] || {
		selecta_cfg_get ".$_cfg_key" 'null'
		printf '\n'
		return 0
	}
	_cfg_val=$*
	case $_cfg_val in
	true | false | null | [0-9]*) ;;
	*) _cfg_val=$(printf '%s' "$_cfg_val" | jq -R .) ;;
	esac
	selecta_ensure_dirs || selecta_die "$EX_UNWRITABLE" "cannot write to $SELECTA_HOME"
	selecta_cfg_set ".$_cfg_key" "$_cfg_val"
	printf '%s = %s\n' "$_cfg_key" "$_cfg_val"
}

cmd_uninstall() {
	selecta_sl_uninstall 2>/dev/null || true
	selecta_ipc_command '["quit"]' >/dev/null 2>&1 || true
	if [ "${1:-}" = --purge ]; then
		if [ "${2:-}" != "--confirm" ] || [ "${3:-}" != PURGE ]; then
			printf 'This deletes every crate for every repo.\n'
			selecta_confirm PURGE 'Type PURGE to confirm: ' \
				'selecta uninstall --purge --confirm PURGE' || return $?
		fi
		rm -rf "$SELECTA_HOME"
		printf 'Removed %s\n' "$SELECTA_HOME"
	else
		printf 'Status line removed and player stopped. Crates kept in %s\n' "$SELECTA_HOME"
		printf 'To delete them too: selecta uninstall --purge\n'
	fi
}

main() {
	[ $# -gt 0 ] || set -- status

	case $1 in
	-h | --help | help)
		usage
		exit 0
		;;
	-V | --version | version)
		printf 'selecta %s\n' "$SELECTA_VERSION"
		exit 0
		;;
	esac

	_selecta_write_pointers

	cmd=$(canonicalize "$1")
	shift

	# jq underpins resolution, state and the crate. Without it every path dies
	# mid-command with a bare "command not found"; say so once instead.
	case $cmd in
	doctor) ;;
	*)
		if ! selecta_have jq; then
			printf 'selecta: jq is required.\n\n  %s\n\nThen: selecta doctor\n' \
				"$(selecta_install_hint 'jq mpv')" >&2
			exit "$EX_MISSING_DEP"
		fi
		;;
	esac

	case $cmd in
	'' | status) cmd_status ;;
	play) cmd_play "$@" ;;
	resume) cmd_resume ;;
	next) cmd_next ;;
	pause) cmd_pause ;;
	go) cmd_go ;;
	stop) cmd_stop ;;
	vol) cmd_vol "$@" ;;
	crate) cmd_crate "$@" ;;
	stations) cmd_stations "$@" ;;
	statusline) cmd_statusline "$@" ;;
	doctor) cmd_doctor ;;
	config) cmd_config "$@" ;;
	resolve) cmd_resolve "$@" ;;
	uninstall) cmd_uninstall "$@" ;;
	*) unknown_subcommand "$cmd" ;;
	esac
}

# selecta resolve [--json] [--offline] <free text>
# The machine-readable half of the natural-language path.
cmd_resolve() {
	_rs_json=0
	_rs_tags=''
	_rs_query=''
	while [ $# -gt 0 ]; do
		case $1 in
		--json) _rs_json=1 ;;
		--offline) SELECTA_OFFLINE=1 ;;
		--tags)
			shift
			_rs_tags=${1:-}
			;;
		--*) selecta_die "$EX_USAGE" "unknown option $1" ;;
		*) _rs_query="$_rs_query${_rs_query:+ }$1" ;;
		esac
		shift
	done
	export SELECTA_OFFLINE

	[ -n "$_rs_query" ] || [ -n "$_rs_tags" ] ||
		selecta_die "$EX_USAGE" "resolve needs something to look for"
	selecta_ensure_dirs || selecta_die "$EX_UNWRITABLE" "cannot write to $SELECTA_HOME"

	if [ -n "$_rs_tags" ]; then
		_rs_out=$(selecta_resolve_net "$_rs_query" "$_rs_tags")
	else
		_rs_out=$(selecta_resolve "$_rs_query")
		# resolve has to answer the same question cmd_play does, or the model
		# reads a radio-only result for a named song and concludes there is
		# nothing to play. It consults YouTube on exactly the same condition.
		if wants_youtube "$_rs_query" "$_rs_out"; then
			if _rs_yb=$(selecta_yt_bin); then
				_rs_yt=$("$_rs_yb" __resolve "$_rs_query" 2>/dev/null) || _rs_yt=''
				case $(printf '%s' "$_rs_yt" | jq -r '.status // ""' 2>/dev/null) in
				ok) _rs_out=$_rs_yt ;;
				'') ;;
				*)
					_rs_out=$(printf '%s' "$_rs_out" | jq -c \
						--arg n "$(printf '%s' "$_rs_yt" | jq -r .status)" \
						'. + {youtube: $n}')
					;;
				esac
			else
				_rs_out=$(printf '%s' "$_rs_out" | jq -c '. + {youtube: "notinstalled"}')
			fi
		fi
		if [ "$(printf '%s' "$_rs_out" | jq -r .status)" != ok ]; then
			_rs_hint=$(printf '%s' "$_rs_out" | jq -r '.hint_tags|join(",")')
			[ -n "$_rs_hint" ] && _rs_out=$(selecta_resolve_net "$_rs_query" "$_rs_hint")
		fi
	fi

	if [ "$_rs_json" -eq 1 ]; then
		printf '%s\n' "$_rs_out"
		return 0
	fi
	printf '%s' "$_rs_out" | jq -r '
		"\(.status)  (confidence \(.confidence))",
		(if (.hint_tags|length) > 0 then "tags: " + (.hint_tags|join(", ")) else empty end),
		"",
		(.candidates[] | "  \(.score)  \(.id)\n        \(.title) — \(.genre // "")  [\(.why)]")'
}

main "$@"
