#!/usr/bin/env python3
"""Local control server for the YouTube mini player.

The IFrame Player API talks postMessage to youtube.com and needs a real
http(s) origin to do it, so the player page cannot be opened from file://.
This serves it from 127.0.0.1 on an ephemeral port and carries the control
channel in both directions:

    GET  /            the player page
    GET  /cmd         next queued command, long-polled by the page
    POST /state       the page reporting what it is doing
    GET  /health      liveness

Bound to loopback only, and every response carries a token the page is given
at load time, so nothing else on the machine can drive the player.

Started and owned by selecta-supervisor. Writes nothing durable itself: state
callbacks are handed to `bin/selecta __yt-state`, which reuses the same state
and segment rendering as the radio path.
"""

import http.server
import json
import os
import secrets
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
from pathlib import Path

HOME = Path(os.environ.get("SELECTA_HOME", str(Path.home() / ".claude" / "selecta")))
ROOT = Path(os.environ["SELECTA_ROOT"])
RUN = HOME / "run"
RUN.mkdir(parents=True, exist_ok=True)

TOKEN = secrets.token_urlsafe(24)
PAGE = (ROOT / "player" / "index.html").read_text(encoding="utf-8")

_lock = threading.Lock()
_queue = []
_seq = 0
# Last time the page polled. The page polls /cmd continuously, so this doubles
# as a liveness signal: if the user closes the window the polls stop, and the
# shell can tell the difference between "player is up" and "window is gone".
_last_seen = 0.0


def _write(path: Path, text: str) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)


DAILY_SEARCHES = 100


def _quota():
    """Search quota, read straight from the cache file the shell maintains.

    Only a new, uncached search spends a unit. Playback spends nothing, and a
    repeated query is served from a 7 day cache, so replaying a song is free.
    """
    f = HOME / "cache" / "yt-quota.json"
    used = 0
    try:
        import datetime, zoneinfo
        today = datetime.datetime.now(
            zoneinfo.ZoneInfo("America/Los_Angeles")).strftime("%Y-%m-%d")
        data = json.loads(f.read_text(encoding="utf-8"))
        if data.get("date") == today:
            used = int(data.get("searches", 0))
    except Exception:
        used = 0
    return {"used": used, "left": max(0, DAILY_SEARCHES - used), "total": DAILY_SEARCHES}


def _drain_commands():
    """Commands are dropped in by bin/selecta as a file, since the client is a
    shell script and should not need an HTTP client to queue one."""
    global _seq
    f = RUN / "yt-cmd.json"
    if not f.exists():
        return
    try:
        cmd = json.loads(f.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        f.unlink(missing_ok=True)
        return
    f.unlink(missing_ok=True)
    with _lock:
        _seq += 1
        cmd["seq"] = _seq
        _queue.append(cmd)


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_args):
        """Silence. The supervisor runs as a plugin monitor, where any stray
        output is surfaced to the session as a notification."""

    def _send(self, code, body: bytes, ctype="application/json"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _authed(self, params) -> bool:
        return secrets.compare_digest(params.get("t", [""])[0], TOKEN)

    def do_GET(self):
        global _last_seen
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)

        if parsed.path == "/health":
            with _lock:
                seen = _last_seen
            age = (time.monotonic() - seen) if seen else None
            body = {"ok": True, "page_age": age}
            return self._send(200, json.dumps(body).encode())

        if parsed.path == "/":
            page = PAGE.replace("__TOKEN__", TOKEN).replace("__ORIGIN__", self._origin())
            return self._send(200, page.encode("utf-8"), "text/html; charset=utf-8")

        if parsed.path == "/cmd":
            if not self._authed(params):
                return self._send(403, b'{"error":"forbidden"}')
            with _lock:
                _last_seen = time.monotonic()
            _drain_commands()
            with _lock:
                cmd = _queue.pop(0) if _queue else None
            return self._send(200, json.dumps({"cmd": cmd, "quota": _quota()}).encode())

        return self._send(404, b'{"error":"not found"}')

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        if parsed.path != "/state" or not self._authed(params):
            return self._send(403, b'{"error":"forbidden"}')

        length = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(length) if length else b"{}"
        try:
            payload = json.loads(raw)
        except json.JSONDecodeError:
            return self._send(400, b'{"error":"bad json"}')

        # Handed to the shell so state and segment rendering stay in one place
        # rather than being reimplemented here. Roughly one call per track.
        try:
            subprocess.run(
                [str(ROOT / "bin" / "selecta"), "__yt-state"],
                input=json.dumps(payload),
                text=True,
                capture_output=True,
                timeout=10,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            pass
        return self._send(200, b'{"ok":true}')

    def _origin(self):
        host, port = self.server.server_address[:2]
        return f"http://{host}:{port}"


def main():
    # Port 0 lets the OS pick a free one; loopback only, never 0.0.0.0.
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    server.daemon_threads = True
    host, port = server.server_address[:2]

    _write(RUN / "httpd.json", json.dumps({
        "url": f"http://{host}:{port}/?t={TOKEN}",
        "origin": f"http://{host}:{port}",
        "port": port,
        "token": TOKEN,
        "pid": os.getpid(),
    }))

    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        (RUN / "httpd.json").unlink(missing_ok=True)
        server.server_close()


if __name__ == "__main__":
    try:
        main()
    except OSError as exc:
        print(f"selecta: player server failed to bind: {exc}", file=sys.stderr)
        raise SystemExit(1)
    except (socket.error, RuntimeError) as exc:
        print(f"selecta: player server error: {exc}", file=sys.stderr)
        raise SystemExit(1)
